import React, { useEffect, useState } from "react"
import {
  CButton,
  CCard,
  CCardBody,
  CCardHeader,
  CCardFooter,
  CContainer,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CForm,
  CFormInput,
  CFormSelect,
  CFormLabel,
  CModal,
  CModalBody,
  CModalHeader,
  CModalTitle,
  CModalFooter,
  CNav,
  CNavItem,
  CNavLink,
  CTabContent,
  CTabPane,
  CToast,
  CToastHeader,
  CToastBody,
  CToaster,
  CBadge,
  CAvatar,
  CProgress,
  CSpinner,
  CAlert,
  CInputGroup,
  CInputGroupText,
  CTooltip,
  CPagination,
  CPaginationItem
} from "@coreui/react"

import CIcon from "@coreui/icons-react"
import { 
  cilPencil, 
  cilTrash, 
  cilMagnifyingGlass, 
  cilPlus,
  cilFilter,
  cilSearch,
  cilInfo,
  cilWarning,
  cilCheckCircle,
  cilX,
  cilCart,
  cilDollar,
  cilTags,
  cilSortAscending,
  cilSortDescending,
  cilCalendar,
  cilBarChart,
  cilCloudDownload,
  cilPrint,
  cilEye,
  cilSave,
  cilArrowLeft,
  cilArrowRight,
  cilChartLine
} from "@coreui/icons"

const Products = () => {
  // ---------------------- ESTADOS MEJORADOS ---------------------- //
  const [products, setProducts] = useState([])
  const [loading, setLoading] = useState(true)
  const [toasts, setToasts] = useState([])
  const [modalVisible, setModalVisible] = useState(false)
  const [modalType, setModalType] = useState(null)
  const [step, setStep] = useState(1)
  const [selectedItem, setSelectedItem] = useState(null)
  
  // ---------------------- FILTROS Y BÚSQUEDA ---------------------- //
  const [searchTerm, setSearchTerm] = useState('')
  const [filterCategory, setFilterCategory] = useState('')
  const [filterStatus, setFilterStatus] = useState('')
  const [sortConfig, setSortConfig] = useState({ key: 'id', direction: 'asc' })
  const [currentPage, setCurrentPage] = useState(1)
  const [itemsPerPage, setItemsPerPage] = useState(10)

  // ---------------------- FORM STATE ---------------------- //
  const [formData, setFormData] = useState({
    Nombre: "",
    Categoria: "",
    Estatus: "",
    Cantidad: "",
    Precio_Unit: "",
    Descripcion: "",
    Proveedor: "",
    Codigo: "",
    Imagen: "",
    Fecha_Ingreso: new Date().toISOString().split('T')[0],
    Garantia: "12 meses",
    Unidad_Medida: "Unidad"
  })

  // ---------------------- JSON-SERVER CONFIG ---------------------- //
  const API = "http://localhost:4000/products"

  // ======================= FUNCIONES PRINCIPALES ======================= //

  const showToast = (type, message, title = null) => {
    const titles = {
      success: '¡Éxito!',
      primary: 'Información',
      warning: 'Advertencia',
      danger: 'Error'
    }
    
    setToasts((prev) => [...prev, { 
      id: Date.now(), 
      type, 
      message,
      title: title || titles[type] || 'Notificación'
    }])
  }

  const openModal = (type, item = null) => {
    setModalType(type)
    setSelectedItem(item)

    if (item) {
      setFormData({
        ...item,
        Fecha_Ingreso: item.Fecha_Ingreso || new Date().toISOString().split('T')[0]
      })
    } else {
      setFormData({
        Nombre: "",
        Categoria: "",
        Estatus: "Disponible",
        Cantidad: "",
        Precio_Unit: "",
        Descripcion: "",
        Proveedor: "",
        Codigo: `PROD-${Date.now().toString().slice(-6)}`,
        Imagen: "",
        Fecha_Ingreso: new Date().toISOString().split('T')[0],
        Garantia: "12 meses",
        Unidad_Medida: "Unidad"
      })
    }

    setStep(1)
    setModalVisible(true)
  }

  // ======================= CRUD OPERATIONS ======================= //

  // Obtener productos
  const loadProducts = async () => {
    setLoading(true)
    try {
      const res = await fetch(API)
      if (!res.ok) throw new Error('Error al cargar productos')
      const data = await res.json()
      setProducts(data)
    } catch (error) {
      showToast('danger', 'Error al cargar productos: ' + error.message)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    loadProducts()
  }, [])

  // Guardar nuevo producto
  const saveItem = async () => {
    try {
      const res = await fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...formData,
          id: Date.now(), // json-server genera ID automáticamente, pero por si acaso
          Cantidad: parseInt(formData.Cantidad) || 0,
          Precio_Unit: parseFloat(formData.Precio_Unit) || 0
        })
      })

      if (!res.ok) throw new Error('Error al guardar')
      
      showToast("success", "Producto registrado correctamente", "Registro exitoso")
      setModalVisible(false)
      loadProducts()
    } catch (error) {
      showToast('danger', 'Error al guardar producto: ' + error.message)
    }
  }

  // Actualizar producto
  const updateItem = async () => {
    try {
      const res = await fetch(`${API}/${selectedItem.id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...formData,
          Cantidad: parseInt(formData.Cantidad) || 0,
          Precio_Unit: parseFloat(formData.Precio_Unit) || 0
        })
      })

      if (!res.ok) throw new Error('Error al actualizar')
      
      showToast("primary", "Producto actualizado correctamente", "Actualización exitosa")
      setModalVisible(false)
      loadProducts()
    } catch (error) {
      showToast('danger', 'Error al actualizar producto: ' + error.message)
    }
  }

  // Eliminar producto
  const deleteItem = async () => {
    try {
      const res = await fetch(`${API}/${selectedItem.id}`, { method: "DELETE" })
      
      if (!res.ok) throw new Error('Error al eliminar')
      
      showToast("danger", "Producto eliminado correctamente", "Eliminación exitosa")
      setModalVisible(false)
      loadProducts()
    } catch (error) {
      showToast('danger', 'Error al eliminar producto: ' + error.message)
    }
  }

  // ======================= FUNCIONES ADICIONALES ======================= //

  const handleChange = (e) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value
    })
  }

  const handleSort = (key) => {
    let direction = 'asc'
    if (sortConfig.key === key && sortConfig.direction === 'asc') {
      direction = 'desc'
    }
    setSortConfig({ key, direction })
  }

  const sortedProducts = [...products].sort((a, b) => {
    if (a[sortConfig.key] < b[sortConfig.key]) {
      return sortConfig.direction === 'asc' ? -1 : 1
    }
    if (a[sortConfig.key] > b[sortConfig.key]) {
      return sortConfig.direction === 'asc' ? 1 : -1
    }
    return 0
  })

  // Filtrar productos
  const filteredProducts = sortedProducts.filter(product => {
    const matchesSearch = product.Nombre?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         product.Codigo?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         product.Descripcion?.toLowerCase().includes(searchTerm.toLowerCase())
    const matchesCategory = filterCategory ? product.Categoria === filterCategory : true
    const matchesStatus = filterStatus ? product.Estatus === filterStatus : true
    return matchesSearch && matchesCategory && matchesStatus
  })

  // Paginación
  const totalPages = Math.ceil(filteredProducts.length / itemsPerPage)
  const startIndex = (currentPage - 1) * itemsPerPage
  const endIndex = startIndex + itemsPerPage
  const currentItems = filteredProducts.slice(startIndex, endIndex)

  // Estadísticas
  const stats = {
    total: products.length,
    disponibles: products.filter(p => p.Estatus === 'Disponible').length,
    agotados: products.filter(p => p.Estatus === 'Agotado').length,
    bajoStock: products.filter(p => parseInt(p.Cantidad) < 10).length,
    valorTotal: products.reduce((sum, p) => sum + (parseFloat(p.Precio_Unit) * parseInt(p.Cantidad)), 0),
    categorias: [...new Set(products.map(p => p.Categoria))].length
  }

  // ======================= RENDER ======================= //

  if (loading && products.length === 0) {
    return (
      <div className="d-flex justify-content-center align-items-center" style={{ height: '50vh' }}>
        <CSpinner color="primary" size="lg" />
        <span className="ms-3">Cargando productos...</span>
      </div>
    )
  }

  return (
    <>
      {/* ======================= ENCABEZADO ======================= */}
      <div className="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 className="fw-bold mb-2" style={{ color: '#2c3e50', fontSize: '2.2rem' }}>
            <CIcon icon={cilCart} className="me-2" />
            Gestión de Productos
          </h1>
          <p className="text-muted mb-0">
            Administra el inventario de productos ({stats.total} productos registrados)
          </p>
        </div>
        
        <div className="d-flex gap-2">
          <CButton color="primary" className="d-flex align-items-center" onClick={() => openModal("create")}>
            <CIcon icon={cilPlus} className="me-2" />
            Nuevo Producto
          </CButton>
          
          <CButton color="secondary" variant="outline" className="d-flex align-items-center">
            <CIcon icon={cilCloudDownload} className="me-2" />
            Exportar
          </CButton>
        </div>
      </div>

      {/* ======================= ESTADÍSTICAS ======================= */}
      <CRow className="mb-4">
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-primary border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Total</h6>
                  <h4 className="mb-0">{stats.total}</h4>
                </div>
                <div className="avatar-sm bg-primary bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilCart} className="text-primary" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
        
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-success border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Disponibles</h6>
                  <h4 className="mb-0">{stats.disponibles}</h4>
                </div>
                <div className="avatar-sm bg-success bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilCheckCircle} className="text-success" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
        
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-danger border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Agotados</h6>
                  <h4 className="mb-0">{stats.agotados}</h4>
                </div>
                <div className="avatar-sm bg-danger bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilX} className="text-danger" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
        
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-warning border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Bajo Stock</h6>
                  <h4 className="mb-0">{stats.bajoStock}</h4>
                </div>
                <div className="avatar-sm bg-warning bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilWarning} className="text-warning" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
        
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-info border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Categorías</h6>
                  <h4 className="mb-0">{stats.categorias}</h4>
                </div>
                <div className="avatar-sm bg-info bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilTags} className="text-info" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
        
        <CCol xs={6} sm={4} md={2}>
          <CCard className="border-start border-secondary border-4 shadow-sm">
            <CCardBody className="py-3">
              <div className="d-flex justify-content-between align-items-center">
                <div>
                  <h6 className="text-muted mb-1">Valor Total</h6>
                  <h4 className="mb-0">${stats.valorTotal.toLocaleString()}</h4>
                </div>
                <div className="avatar-sm bg-secondary bg-opacity-10 rounded-circle p-2">
                  <CIcon icon={cilDollar} className="text-secondary" size="lg" />
                </div>
              </div>
            </CCardBody>
          </CCard>
        </CCol>
      </CRow>

      {/* ======================= BARRA DE HERRAMIENTAS ======================= */}
      <CCard className="shadow-sm mb-4">
        <CCardBody>
          <CRow className="g-3 align-items-center">
            <CCol md={3}>
              <CInputGroup>
                <CInputGroupText>
                  <CIcon icon={cilSearch} />
                </CInputGroupText>
                <CFormInput
                  placeholder="Buscar producto, código o descripción..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
              </CInputGroup>
            </CCol>

            <CCol md={2}>
              <CFormSelect
                value={filterCategory}
                onChange={(e) => setFilterCategory(e.target.value)}
              >
                <option value="">Todas las categorías</option>
                <option value="Tecnología">Tecnología</option>
                <option value="Mobiliario">Mobiliario</option>
                <option value="Oficina">Oficina</option>
                <option value="Limpieza">Limpieza</option>
                <option value="Alimentos">Alimentos</option>
                <option value="Bebidas">Bebidas</option>
              </CFormSelect>
            </CCol>

            <CCol md={2}>
              <CFormSelect
                value={filterStatus}
                onChange={(e) => setFilterStatus(e.target.value)}
              >
                <option value="">Todos los estados</option>
                <option value="Disponible">Disponible</option>
                <option value="Agotado">Agotado</option>
                <option value="Reservado">Reservado</option>
                <option value="Descontinuado">Descontinuado</option>
              </CFormSelect>
            </CCol>

            <CCol md={2}>
              <CFormSelect
                value={itemsPerPage}
                onChange={(e) => setItemsPerPage(Number(e.target.value))}
              >
                <option value="5">5 por página</option>
                <option value="10">10 por página</option>
                <option value="20">20 por página</option>
                <option value="50">50 por página</option>
              </CFormSelect>
            </CCol>

            <CCol md={3} className="text-end">
              <div className="d-flex gap-2 justify-content-end">
                {(searchTerm || filterCategory || filterStatus) && (
                  <CButton 
                    variant="outline"
                    onClick={() => {
                      setSearchTerm('')
                      setFilterCategory('')
                      setFilterStatus('')
                    }}
                  >
                    <CIcon icon={cilX} /> Limpiar
                  </CButton>
                )}
                
                <CButton color="info" variant="outline">
                  <CIcon icon={cilFilter} /> Filtros Avanzados
                </CButton>
              </div>
            </CCol>
          </CRow>
        </CCardBody>
      </CCard>

      {/* ======================= TABLA MEJORADA ======================= */}
      <CCard className="shadow-sm">
        <CCardHeader className="bg-light">
          <div className="d-flex justify-content-between align-items-center">
            <h5 className="mb-0">Inventario de Productos</h5>
            <span className="text-muted">
              Mostrando {startIndex + 1}-{Math.min(endIndex, filteredProducts.length)} de {filteredProducts.length}
            </span>
          </div>
        </CCardHeader>
        
        <CCardBody className="p-0">
          <CTable hover responsive className="mb-0">
            <CTableHead color="light">
              <CTableRow>
                <CTableHeaderCell style={{ width: '70px' }}>ID</CTableHeaderCell>
                <CTableHeaderCell 
                  style={{ cursor: 'pointer' }}
                  onClick={() => handleSort('Nombre')}
                >
                  <div className="d-flex align-items-center">
                    Producto
                    {sortConfig.key === 'Nombre' && (
                      <CIcon 
                        icon={sortConfig.direction === 'asc' ? cilSortAscending : cilSortDescending} 
                        className="ms-1" 
                      />
                    )}
                  </div>
                </CTableHeaderCell>
                <CTableHeaderCell>Categoría</CTableHeaderCell>
                <CTableHeaderCell 
                  style={{ cursor: 'pointer' }}
                  onClick={() => handleSort('Cantidad')}
                >
                  <div className="d-flex align-items-center">
                    Stock
                    {sortConfig.key === 'Cantidad' && (
                      <CIcon 
                        icon={sortConfig.direction === 'asc' ? cilSortAscending : cilSortDescending} 
                        className="ms-1" 
                      />
                    )}
                  </div>
                </CTableHeaderCell>
                <CTableHeaderCell 
                  style={{ cursor: 'pointer' }}
                  onClick={() => handleSort('Precio_Unit')}
                >
                  <div className="d-flex align-items-center">
                    Precio
                    {sortConfig.key === 'Precio_Unit' && (
                      <CIcon 
                        icon={sortConfig.direction === 'asc' ? cilSortAscending : cilSortDescending} 
                        className="ms-1" 
                      />
                    )}
                  </div>
                </CTableHeaderCell>
                <CTableHeaderCell>Estado</CTableHeaderCell>
                <CTableHeaderCell>Valor Total</CTableHeaderCell>
                <CTableHeaderCell>Acciones</CTableHeaderCell>
              </CTableRow>
            </CTableHead>
            
            <CTableBody>
              {currentItems.length === 0 ? (
                <CTableRow>
                  <CTableDataCell colSpan="8" className="text-center py-5">
                    <CIcon icon={cilInfo} size="xl" className="text-muted mb-3" />
                    <h5>No se encontraron productos</h5>
                    <p className="text-muted">Intenta con otros filtros o agrega un nuevo producto</p>
                  </CTableDataCell>
                </CTableRow>
              ) : (
                currentItems.map((item) => {
                  const cantidad = parseInt(item.Cantidad) || 0
                  const precio = parseFloat(item.Precio_Unit) || 0
                  const valorTotal = cantidad * precio
                  
                  return (
                    <CTableRow key={item.id}>
                      <CTableDataCell>
                        <div className="text-center">
                          <strong>#{item.id}</strong>
                          <div className="small text-muted">{item.Codigo}</div>
                        </div>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <div className="d-flex align-items-center">
                          <div className="avatar-sm bg-light rounded-circle p-2 me-3">
                            <CIcon icon={cilCart} className="text-primary" />
                          </div>
                          <div>
                            <strong>{item.Nombre}</strong>
                            <div className="small text-muted text-truncate" style={{ maxWidth: '200px' }}>
                              {item.Descripcion || 'Sin descripción'}
                            </div>
                          </div>
                        </div>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <CBadge color="secondary" shape="rounded-pill">
                          {item.Categoria || 'Sin categoría'}
                        </CBadge>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <div>
                          <div className="d-flex justify-content-between mb-1">
                            <span className="fw-bold">{cantidad} unidades</span>
                            <small className={cantidad < 10 ? 'text-danger' : 'text-success'}>
                              {cantidad < 10 ? 'Bajo stock' : 'Suficiente'}
                            </small>
                          </div>
                          <CProgress 
                            value={Math.min(cantidad, 100)} 
                            color={
                              cantidad === 0 ? 'danger' :
                              cantidad < 10 ? 'warning' : 'success'
                            }
                          />
                        </div>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <div className="fw-bold">${precio.toLocaleString()}</div>
                        <small className="text-muted">por unidad</small>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <CBadge
                          color={
                            item.Estatus === 'Disponible' ? 'success' :
                            item.Estatus === 'Agotado' ? 'danger' :
                            item.Estatus === 'Reservado' ? 'warning' : 'secondary'
                          }
                          shape="rounded-pill"
                        >
                          {item.Estatus}
                        </CBadge>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <div className="fw-bold">${valorTotal.toLocaleString()}</div>
                        <small className="text-muted">en inventario</small>
                      </CTableDataCell>
                      
                      <CTableDataCell>
                        <div className="d-flex gap-1">
                          <CTooltip content="Ver detalles">
                            <CButton
                              color="info"
                              size="sm"
                              className="text-white"
                              onClick={() => openModal("view", item)}
                            >
                              <CIcon icon={cilEye} />
                            </CButton>
                          </CTooltip>
                          
                          <CTooltip content="Editar">
                            <CButton
                              color="warning"
                              size="sm"
                              className="text-white"
                              onClick={() => openModal("edit", item)}
                            >
                              <CIcon icon={cilPencil} />
                            </CButton>
                          </CTooltip>
                          
                          <CTooltip content="Eliminar">
                            <CButton
                              color="danger"
                              size="sm"
                              onClick={() => openModal("delete", item)}
                            >
                              <CIcon icon={cilTrash} />
                            </CButton>
                          </CTooltip>
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  )
                })
              )}
            </CTableBody>
          </CTable>
        </CCardBody>
        
        {/* ======================= PAGINACIÓN ======================= */}
        <CCardFooter>
          <div className="d-flex justify-content-between align-items-center">
            <div>
              <span className="text-muted">
                Mostrando {startIndex + 1}-{Math.min(endIndex, filteredProducts.length)} de {filteredProducts.length} productos
              </span>
            </div>
            
            <CPagination align="center">
              <CPaginationItem 
                disabled={currentPage === 1}
                onClick={() => setCurrentPage(1)}
              >
                Primera
              </CPaginationItem>
              
              <CPaginationItem 
                disabled={currentPage === 1}
                onClick={() => setCurrentPage(prev => prev - 1)}
              >
                <CIcon icon={cilArrowLeft} />
              </CPaginationItem>
              
              {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                let pageNum
                if (totalPages <= 5) {
                  pageNum = i + 1
                } else if (currentPage <= 3) {
                  pageNum = i + 1
                } else if (currentPage >= totalPages - 2) {
                  pageNum = totalPages - 4 + i
                } else {
                  pageNum = currentPage - 2 + i
                }
                
                return (
                  <CPaginationItem 
                    key={pageNum}
                    active={currentPage === pageNum}
                    onClick={() => setCurrentPage(pageNum)}
                  >
                    {pageNum}
                  </CPaginationItem>
                )
              })}
              
              <CPaginationItem 
                disabled={currentPage === totalPages}
                onClick={() => setCurrentPage(prev => prev + 1)}
              >
                <CIcon icon={cilArrowRight} />
              </CPaginationItem>
              
              <CPaginationItem 
                disabled={currentPage === totalPages}
                onClick={() => setCurrentPage(totalPages)}
              >
                Última
              </CPaginationItem>
            </CPagination>
          </div>
        </CCardFooter>
      </CCard>

      {/* ======================= TOASTER MEJORADO ======================= */}
      <CToaster placement="top-end">
        {toasts.map((t) => (
          <CToast key={t.id} autohide={3000} color={t.type} visible>
            <CToastHeader closeButton>
              <CIcon 
                icon={
                  t.type === 'success' ? cilCheckCircle :
                  t.type === 'danger' ? cilX :
                  t.type === 'warning' ? cilWarning : cilInfo
                } 
                className="me-2" 
              />
              <strong className="me-auto">{t.title}</strong>
            </CToastHeader>
            <CToastBody>{t.message}</CToastBody>
          </CToast>
        ))}
      </CToaster>

      {/* ======================= MODAL MEJORADO ======================= */}
      <CModal size="lg" visible={modalVisible} onClose={() => setModalVisible(false)}>
        <CModalHeader className={`${
          modalType === 'delete' ? 'bg-danger text-white' :
          modalType === 'edit' ? 'bg-warning text-white' :
          'bg-primary text-white'
        }`}>
          <div className="d-flex align-items-center">
            <CIcon 
              icon={
                modalType === 'delete' ? cilTrash :
                modalType === 'edit' ? cilPencil :
                modalType === 'view' ? cilEye : cilPlus
              } 
              className="me-2" 
            />
            <CModalTitle>
              {modalType === 'delete' && 'Eliminar Producto'}
              {modalType === 'edit' && 'Editar Producto'}
              {modalType === 'view' && 'Detalles del Producto'}
              {modalType === 'create' && 'Nuevo Producto'}
            </CModalTitle>
          </div>
        </CModalHeader>

        <CModalBody>
          {/* ----------- ELIMINAR ----------- */}
          {modalType === 'delete' && selectedItem && (
            <div className="text-center">
              <div className="avatar-lg bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3">
                <CIcon icon={cilTrash} size="2xl" className="text-danger" />
              </div>
              <h4>¿Eliminar producto permanentemente?</h4>
              <p className="text-muted mb-4">
                Esta acción no se puede deshacer. Se eliminará el producto:
              </p>
              
              <div className="bg-light p-4 rounded mb-4">
                <h5 className="text-danger">{selectedItem.Nombre}</h5>
                <div className="row mt-3">
                  <div className="col-6">
                    <small className="text-muted">Código</small>
                    <div className="fw-bold">{selectedItem.Codigo}</div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Stock actual</small>
                    <div className="fw-bold">{selectedItem.Cantidad} unidades</div>
                  </div>
                </div>
              </div>
              
              <CAlert color="danger">
                <CIcon icon={cilWarning} className="me-2" />
                <strong>Advertencia:</strong> Se perderán todos los datos del producto.
              </CAlert>
            </div>
          )}

          {/* ----------- VER DETALLES ----------- */}
          {modalType === 'view' && selectedItem && (
            <div className="row">
              <div className="col-md-4 text-center mb-4 mb-md-0">
                <div className="avatar-xl bg-light rounded-circle d-inline-flex align-items-center justify-content-center p-5 mb-3">
                  <CIcon icon={cilCart} size="3xl" className="text-primary" />
                </div>
                <h3>{selectedItem.Nombre}</h3>
                <CBadge color="primary">{selectedItem.Codigo}</CBadge>
              </div>
              
              <div className="col-md-8">
                <h5 className="mb-3">Información del Producto</h5>
                <div className="row g-3">
                  <div className="col-6">
                    <small className="text-muted">Categoría</small>
                    <div className="fw-bold">{selectedItem.Categoria}</div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Estado</small>
                    <div>
                      <CBadge
                        color={
                          selectedItem.Estatus === 'Disponible' ? 'success' :
                          selectedItem.Estatus === 'Agotado' ? 'danger' : 'warning'
                        }
                      >
                        {selectedItem.Estatus}
                      </CBadge>
                    </div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Stock</small>
                    <div className="fw-bold">{selectedItem.Cantidad} unidades</div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Precio Unitario</small>
                    <div className="fw-bold">${selectedItem.Precio_Unit}</div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Proveedor</small>
                    <div className="fw-bold">{selectedItem.Proveedor || 'No especificado'}</div>
                  </div>
                  <div className="col-6">
                    <small className="text-muted">Garantía</small>
                    <div className="fw-bold">{selectedItem.Garantia || 'No especificada'}</div>
                  </div>
                  <div className="col-12">
                    <small className="text-muted">Descripción</small>
                    <div className="border rounded p-3 bg-light">
                      {selectedItem.Descripcion || 'Sin descripción'}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* ----------- CREAR / EDITAR ----------- */}
          {(modalType === 'create' || modalType === 'edit') && (
            <>
              <CNav variant="tabs">
                <CNavItem>
                  <CNavLink active={step === 1} onClick={() => setStep(1)}>
                    <CIcon icon={cilInfo} className="me-2" />
                    Información Básica
                  </CNavLink>
                </CNavItem>
                <CNavItem>
                  <CNavLink active={step === 2} onClick={() => setStep(2)}>
                    <CIcon icon={cilDollar} className="me-2" />
                    Precio y Stock
                  </CNavLink>
                </CNavItem>
                <CNavItem>
                  <CNavLink active={step === 3} onClick={() => setStep(3)}>
                    <CIcon icon={cilCheckCircle} className="me-2" />
                    Confirmación
                  </CNavLink>
                </CNavItem>
              </CNav>

              <CTabContent className="mt-4">
                {/* PASO 1 - Información básica */}
                <CTabPane visible={step === 1}>
                  <CRow className="g-3">
                    <CCol md={6}>
                      <CFormInput
                        label="Nombre del producto"
                        name="Nombre"
                        value={formData.Nombre}
                        onChange={handleChange}
                        placeholder="Ej: Laptop Dell Inspiron 15"
                        required
                      />
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        label="Código del producto"
                        name="Codigo"
                        value={formData.Codigo}
                        onChange={handleChange}
                        placeholder="Ej: PROD-001"
                        required
                        readOnly={modalType === 'edit'}
                      />
                    </CCol>
                    <CCol md={6}>
                      <CFormSelect
                        label="Categoría"
                        name="Categoria"
                        value={formData.Categoria}
                        onChange={handleChange}
                        required
                      >
                        <option value="">Seleccione categoría...</option>
                        <option value="Tecnología">Tecnología</option>
                        <option value="Mobiliario">Mobiliario</option>
                        <option value="Oficina">Oficina</option>
                        <option value="Limpieza">Limpieza</option>
                        <option value="Alimentos">Alimentos</option>
                        <option value="Bebidas">Bebidas</option>
                        <option value="Herramientas">Herramientas</option>
                        <option value="Materiales">Materiales</option>
                      </CFormSelect>
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        label="Proveedor"
                        name="Proveedor"
                        value={formData.Proveedor}
                        onChange={handleChange}
                        placeholder="Nombre del proveedor"
                      />
                    </CCol>
                    <CCol md={12}>
                      <CFormInput
                        label="Descripción"
                        name="Descripcion"
                        value={formData.Descripcion}
                        onChange={handleChange}
                        placeholder="Descripción detallada del producto..."
                        text="Ingresa una descripción clara del producto"
                      />
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        type="date"
                        label="Fecha de ingreso"
                        name="Fecha_Ingreso"
                        value={formData.Fecha_Ingreso}
                        onChange={handleChange}
                      />
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        label="Garantía"
                        name="Garantia"
                        value={formData.Garantia}
                        onChange={handleChange}
                        placeholder="Ej: 12 meses, 2 años"
                      />
                    </CCol>
                  </CRow>
                </CTabPane>

                {/* PASO 2 - Precio y Stock */}
                <CTabPane visible={step === 2}>
                  <CRow className="g-3">
                    <CCol md={4}>
                      <CFormInput
                        type="number"
                        label="Cantidad en stock"
                        name="Cantidad"
                        value={formData.Cantidad}
                        onChange={handleChange}
                        placeholder="0"
                        min="0"
                        required
                      />
                    </CCol>
                    <CCol md={4}>
                      <CFormSelect
                        label="Unidad de medida"
                        name="Unidad_Medida"
                        value={formData.Unidad_Medida}
                        onChange={handleChange}
                      >
                        <option value="Unidad">Unidad</option>
                        <option value="Kg">Kilogramo</option>
                        <option value="Litro">Litro</option>
                        <option value="Metro">Metro</option>
                        <option value="Caja">Caja</option>
                        <option value="Paquete">Paquete</option>
                      </CFormSelect>
                    </CCol>
                    <CCol md={4}>
                      <CFormSelect
                        label="Estado del producto"
                        name="Estatus"
                        value={formData.Estatus}
                        onChange={handleChange}
                        required
                      >
                        <option value="Disponible">Disponible</option>
                        <option value="Agotado">Agotado</option>
                        <option value="Reservado">Reservado</option>
                        <option value="Descontinuado">Descontinuado</option>
                      </CFormSelect>
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        type="number"
                        step="0.01"
                        label="Precio unitario ($)"
                        name="Precio_Unit"
                        value={formData.Precio_Unit}
                        onChange={handleChange}
                        placeholder="0.00"
                        min="0"
                        required
                      />
                    </CCol>
                    <CCol md={6}>
                      <CFormInput
                        label="Valor total en inventario"
                        value={(() => {
                          const cantidad = parseFloat(formData.Cantidad) || 0
                          const precio = parseFloat(formData.Precio_Unit) || 0
                          return `$${(cantidad * precio).toLocaleString()}`
                        })()}
                        readOnly
                        className="bg-light"
                      />
                    </CCol>
                    <CCol md={12}>
                      <CAlert color={parseInt(formData.Cantidad) < 10 ? 'warning' : 'success'}>
                        <CIcon icon={cilWarning} className="me-2" />
                        {parseInt(formData.Cantidad) < 10 
                          ? '¡Atención! El stock está por debajo del nivel mínimo recomendado (10 unidades).'
                          : 'Stock suficiente.'}
                      </CAlert>
                    </CCol>
                  </CRow>
                </CTabPane>

                {/* PASO 3 - Confirmación */}
                <CTabPane visible={step === 3}>
                  <div className="text-center mb-4">
                    <div className="avatar-lg bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3">
                      <CIcon icon={cilCheckCircle} size="2xl" className="text-success" />
                    </div>
                    <h4>Confirmar datos del producto</h4>
                    <p className="text-muted">Revisa la información antes de guardar</p>
                  </div>
                  
                  <div className="bg-light p-4 rounded mb-4">
                    <h5 className="border-bottom pb-2">Resumen del Producto</h5>
                    <CRow className="mt-3">
                      <CCol md={6}>
                        <small className="text-muted">Nombre</small>
                        <div className="fw-bold">{formData.Nombre}</div>
                      </CCol>
                      <CCol md={6}>
                        <small className="text-muted">Código</small>
                        <div className="fw-bold">{formData.Codigo}</div>
                      </CCol>
                      <CCol md={6}>
                        <small className="text-muted">Categoría</small>
                        <div className="fw-bold">{formData.Categoria}</div>
                      </CCol>
                      <CCol md={6}>
                        <small className="text-muted">Estado</small>
                        <div>
                          <CBadge
                            color={
                              formData.Estatus === 'Disponible' ? 'success' :
                              formData.Estatus === 'Agotado' ? 'danger' : 'warning'
                            }
                          >
                            {formData.Estatus}
                          </CBadge>
                        </div>
                      </CCol>
                      <CCol md={6}>
                        <small className="text-muted">Stock</small>
                        <div className="fw-bold">{formData.Cantidad} {formData.Unidad_Medida}</div>
                      </CCol>
                      <CCol md={6}>
                        <small className="text-muted">Precio Unitario</small>
                        <div className="fw-bold">${formData.Precio_Unit}</div>
                      </CCol>
                      <CCol md={12} className="mt-3">
                        <small className="text-muted">Descripción</small>
                        <div className="border rounded p-3 bg-white">
                          {formData.Descripcion || 'Sin descripción'}
                        </div>
                      </CCol>
                    </CRow>
                    
                    <div className="bg-white p-3 rounded mt-3">
                      <div className="d-flex justify-content-between">
                        <span>Valor total en inventario:</span>
                        <strong className="fs-5 text-success">
                          ${(() => {
                            const cantidad = parseFloat(formData.Cantidad) || 0
                            const precio = parseFloat(formData.Precio_Unit) || 0
                            return (cantidad * precio).toLocaleString()
                          })()}
                        </strong>
                      </div>
                    </div>
                  </div>
                </CTabPane>
              </CTabContent>
            </>
          )}
        </CModalBody>

        <CModalFooter>
          {modalType === 'delete' && (
            <>
              <CButton color="secondary" onClick={() => setModalVisible(false)}>
                Cancelar
              </CButton>
              <CButton color="danger" onClick={deleteItem}>
                <CIcon icon={cilTrash} className="me-2" />
                Eliminar Permanentemente
              </CButton>
            </>
          )}
          
          {modalType === 'view' && (
            <CButton color="secondary" onClick={() => setModalVisible(false)}>
              Cerrar
            </CButton>
          )}
          
          {(modalType === 'create' || modalType === 'edit') && (
            <div className="d-flex justify-content-between w-100">
              <div>
                {step > 1 && (
                  <CButton color="secondary" onClick={() => setStep(step - 1)}>
                    <CIcon icon={cilArrowLeft} className="me-2" />
                    Atrás
                  </CButton>
                )}
              </div>
              
              <div className="d-flex gap-2">
                {step < 3 ? (
                  <CButton color="primary" onClick={() => setStep(step + 1)}>
                    {step === 2 ? 'Confirmar y Guardar' : 'Siguiente'}
                    <CIcon icon={step === 2 ? cilSave : cilArrowRight} className="ms-2" />
                  </CButton>
                ) : (
                  <>
                    <CButton color="secondary" onClick={() => setStep(2)}>
                      <CIcon icon={cilPencil} className="me-2" />
                      Editar
                    </CButton>
                    {modalType === 'create' ? (
                      <CButton color="success" onClick={saveItem}>
                        <CIcon icon={cilCheckCircle} className="me-2" />
                        Guardar Producto
                      </CButton>
                    ) : (
                      <CButton color="primary" onClick={updateItem}>
                        <CIcon icon={cilSave} className="me-2" />
                        Actualizar Producto
                      </CButton>
                    )}
                  </>
                )}
              </div>
            </div>
          )}
        </CModalFooter>
      </CModal>
    </>
  )
}

